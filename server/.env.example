# Copy this file to .env and fill in real values. .env is git-ignored;
# never commit real SMTP credentials.

# SMTP transport used to send enquiry emails (Nodemailer).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The Foundation's official inbox. Every enquiry is sent here (never to the
# visitor's own address, which is only used as Reply-To).
MAIL_TO=

# The website's own origin. CORS on POST /api/enquiry only accepts requests
# from this origin in production.
ALLOWED_ORIGIN=[production website URL, e.g. https://www.example.org]

# Port this server listens on.
PORT=4000

# Set to 1 (or a proxy hop count) only when this server runs behind a
# reverse proxy, so rate limiting sees the visitor's real IP.
TRUST_PROXY=

# POST /api/enquiry rate limit. Leave both unset for the required default
# (5 requests / 15 minutes / IP). Only the automated test suite overrides
# these, to exercise many non-rate-limit scenarios without tripping it.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
